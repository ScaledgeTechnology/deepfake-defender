<?xml version="1.0" encoding="UTF-8"?>
<configuration>

  <system.webServer>

    <!-- <defaultDocument enabled="true">
      <files>
        <add value="index.html" />
      </files>
    </defaultDocument> -->


    <handlers>
      <add name="Deepfake FastCGI" path="*" verb="*" modules="FastCgiModule"
           scriptProcessor="C:\inetpub\wwwroot\deepfake-defender\myvenv\Scripts\python.exe|C:\inetpub\wwwroot\deepfake-defender\myvenv\Lib\site-packages\wfastcgi.py"
           resourceType="Unspecified" requireAccess="Script" />
    </handlers>

  <!-- <fastCgi>
      <application fullPath="C:\inetpub\wwwroot\deepfake-defender\myvenv\Scripts\python.exe"
                   arguments="C:\inetpub\wwwroot\deepfake-defender\myvenv\Lib\site-packages\wfastcgi.py"
                   activityTimeout="600"
                   requestTimeout="600" />
    </fastCgi> -->


    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="2147483648" /> <!-- 2GB -->
      </requestFiltering>
    </security>

    <httpErrors errorMode="Detailed" />

  </system.webServer>
  <system.web>
    <httpRuntime executionTimeout="600" maxRequestLength="2097152" />
    <customErrors mode="Off" />
  </system.web>
  
  <appSettings>
    <add key="PYTHONPATH" value="C:\inetpub\wwwroot\deepfake-defender\deepfake" />
    <add key="WSGI_HANDLER" value="deepfake.wsgi.application" />
    <add key="DJANGO_SETTINGS_MODULE" value="deepfake.settings" />
  </appSettings>

</configuration>
